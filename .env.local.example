# Supabase project for the leave & gate-pass system.
# This is a SEPARATE project from the accounting app — never point both at one
# database. Copy to .env.local and fill in from Project Settings > API.

# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — NEVER expose to the browser, NEVER commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres URL, used by scripts/migrate.mjs only.
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres

# Google Chat incoming webhooks — two separate spaces (PRD section VI).
# The guard space receives gate passes only, and never a leave reason.
GCHAT_WEBHOOK_APPROVERS=https://chat.googleapis.com/v1/spaces/.../messages?key=...
GCHAT_WEBHOOK_GUARDS=https://chat.googleapis.com/v1/spaces/.../messages?key=...

# Authorizes the scheduled job that sends SLA reminders and runs the nightly
# Directory sync. Generate a long random value.
CRON_SECRET=replace-with-a-long-random-secret

# Google Workspace Directory sync (PRD section XIV). Service account with
# domain-wide delegation, impersonating an admin that can read the directory.
GOOGLE_SA_CLIENT_EMAIL=sync@your-project.iam.gserviceaccount.com
GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DIRECTORY_IMPERSONATE=admin@ctyhp.vn
GOOGLE_WORKSPACE_DOMAIN=ctyhp.vn
